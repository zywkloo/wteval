{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zywkloo/wteval/schemas/decision-v1.schema.json",
  "title": "wteval decision record v1",
  "description": "Runtime advise output consumed by the evaluation lab. Prompt content is not required.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "task_id",
    "created_at",
    "prompt_fingerprint",
    "features_version",
    "classification",
    "advisor_route",
    "recommended_route",
    "forecast",
    "reason_codes"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "decision_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"
    },
    "task_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "created_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt]\\d{2}:\\d{2}:\\d{2}(\\.\\d+)?([Zz]|[+-]\\d{2}:\\d{2})$"
    },
    "prompt_fingerprint": { "type": "string", "minLength": 1 },
    "features_version": { "type": "string", "minLength": 1 },
    "classification": { "$ref": "#/$defs/classification" },
    "advisor_route": { "$ref": "#/$defs/advisorRoute" },
    "recommended_route": { "$ref": "#/$defs/route" },
    "forecast": { "$ref": "#/$defs/forecast" },
    "reason_codes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "human_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["accept", "override", "dismiss", "pending"] },
        "override_reason": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_kind", "size", "risk", "confidence", "recommended_sequence"],
      "properties": {
        "work_kind": {
          "enum": ["discovery", "planning", "execution", "verification", "repair", "finishing"]
        },
        "size": { "enum": ["xs", "s", "m", "l", "xl"] },
        "risk": { "enum": ["low", "medium", "high"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "recommended_sequence": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["planner", "executor", "verifier", "finisher"] }
        },
        "abstain": { "type": "boolean" },
        "classifier_version": { "type": "string", "minLength": 1 }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "endpoint", "model_tier"],
      "properties": {
        "role": { "enum": ["planner", "executor", "verifier", "finisher"] },
        "endpoint": { "type": "string", "minLength": 1 },
        "model_tier": { "type": "string", "minLength": 1 },
        "reasoning_tier": { "type": "string", "minLength": 1 }
      }
    },
    "advisorRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint", "model", "policy"],
      "properties": {
        "endpoint": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "policy": { "enum": ["always", "low-confidence", "shadow", "off"] }
      }
    },
    "forecast": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_confidence"],
      "properties": {
        "reported_tokens_p50": { "type": ["number", "null"], "minimum": 0 },
        "reported_tokens_p90": { "type": ["number", "null"], "minimum": 0 },
        "subscription_quota_delta_p50": { "type": ["number", "null"], "minimum": 0 },
        "subscription_quota_delta_p90": { "type": ["number", "null"], "minimum": 0 },
        "source_confidence": {
          "enum": ["authoritative", "reported", "inferred", "unavailable"]
        },
        "forecast_version": { "type": "string", "minLength": 1 }
      }
    }
  }
}
