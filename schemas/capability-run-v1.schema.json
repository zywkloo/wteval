{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zywkloo/wteval/schemas/capability-run-v1.schema.json",
  "title": "wteval capability run v1",
  "description": "One agent execution of one benchmark task under one experimental arm, scored by wtcraft check/verify (deterministic oracle).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "task_id",
    "created_at",
    "arm",
    "agent",
    "task",
    "result"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"
    },
    "task_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "created_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt]\\d{2}:\\d{2}:\\d{2}(\\.\\d+)?([Zz]|[+-]\\d{2}:\\d{2})$"
    },
    "arm": { "enum": ["contract", "no_contract"] },
    "agent": { "$ref": "#/$defs/agent" },
    "task": { "$ref": "#/$defs/task" },
    "result": { "$ref": "#/$defs/result" },
    "usage": { "$ref": "#/$defs/usage" },
    "notes": { "type": "string" }
  },
  "$defs": {
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint", "model", "config_version"],
      "properties": {
        "endpoint": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "config_version": { "type": "string", "minLength": 1 }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "base_revision", "oracle_revision", "prompt_fingerprint"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "base_revision": { "type": "string", "minLength": 1 },
        "oracle_revision": { "type": "string", "minLength": 1 },
        "prompt_fingerprint": { "type": "string", "minLength": 1 },
        "verification_declared": { "type": "boolean" },
        "verification": { "type": "string", "minLength": 1 },
        "origin": { "enum": ["history", "mutation", "pbt", "fixture"] }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check", "verify", "repair_rounds", "replan"],
      "properties": {
        "check": { "enum": ["pass", "fail", "skip", "unavailable"] },
        "verify": { "enum": ["pass", "fail", "skip", "unavailable"] },
        "repair_rounds": { "type": "integer", "minimum": 0 },
        "replan": { "type": "boolean" }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "source_confidence"],
      "properties": {
        "reported_tokens": { "type": ["number", "null"], "minimum": 0 },
        "subscription_quota_delta": { "type": ["number", "null"], "minimum": 0 },
        "source": { "type": "string", "minLength": 1 },
        "source_confidence": {
          "enum": ["authoritative", "reported", "inferred", "unavailable"]
        }
      }
    }
  }
}
