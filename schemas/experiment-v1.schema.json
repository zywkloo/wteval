{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zywkloo/wteval/schemas/experiment-v1.schema.json",
  "title": "wteval experiment config v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "dataset",
    "systems",
    "metrics",
    "split"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "experiment_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"
    },
    "dataset": { "type": "string", "minLength": 1 },
    "systems": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["classification", "forecast", "recommendation"] }
    },
    "split": { "enum": ["holdout", "train", "all"] },
    "description": { "type": "string" },
    "holdout_fraction": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 }
  }
}
